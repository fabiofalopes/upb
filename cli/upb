def discover_new_models(cfg):
    """For providers flagged `discover: true`, report upstream models not yet in routes.yaml.

    Report-only — never edits routes.yaml. Intended for rotating catalogs such as
    OpenCode Zen's free tier, where new models appear over time.
    """
    targets = []
    for pname, prov in sorted_providers(cfg):
        if not prov.get("enabled", True):
            continue
        if not prov.get("discover"):
            continue
        if is_catalog(prov):
            continue  # live-catalog providers already auto-discover
        if not prov.get("base_url"):
            continue
        targets.append((pname, prov))
    if not targets:
        return
    print("\nModel discovery (providers with discover: true):")
    for pname, prov in targets:
        key, desc = resolve_key(prov.get("key"))
        if key is None:
            print(f"  {pname}: skipped — key unavailable ({desc})")
            continue
        configured = set((prov.get("models") or {}).keys())
        match = prov.get("discover_match")  # optional substring filter for reported models
        url = prov["base_url"].rstrip("/") + "/models"
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "upb-discover/1.0"})
            if key:
                req.add_header("Authorization", f"Bearer {key}")
            with urllib.request.urlopen(req, timeout=8) as resp:
                data = json.loads(resp.read())
            available = [m.get("id") for m in data.get("data", []) if m.get("id")]
        except Exception as e:
            print(f"  {pname}: discovery failed ({type(e).__name__})")
            continue
        new_models = [m for m in available if m not in configured]
        if match:
            new_models = [m for m in new_models if match in m]
        if new_models:
            print(f"  {pname}: {len(new_models)} NEW upstream model(s) not in routes.yaml:")
            for m in new_models:
                print(f"      + {m}")
            print(f"      add under providers.{pname}.models in routes.yaml to enable")
        else:
            print(f"  {pname}: up to date ({len(configured)} configured / {len(available)} upstream)")


def cmd_sync(cfg, args):
    """Sync secrets: pull from source stores → secrets.env → push to derived files."""
    import re as _re

    secrets = {}
    if SECRETS_PATH.exists():
        for line in SECRETS_PATH.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                k, _, v = line.partition("=")
                secrets[k.strip()] = v.strip().strip("'\"")

    changed = []

    # ── Pull: opencode auth.json → secrets.env ──
    auth_path = Path("~/.local/share/opencode/auth.json").expanduser()
    if auth_path.exists():
        try:
            auth = json.loads(auth_path.read_text())
            pulls = [
                ("alibaba-token-plan", "ALIBABA_TOKEN_PLAN_KEY"),
                ("opencode-go", "OPENCODE_GO_KEY"),
            ]
            for entry_name, env_name in pulls:
                if entry_name in auth and auth[entry_name].get("key"):
                    new_val = auth[entry_name]["key"]
                    if secrets.get(env_name) != new_val:
                        secrets[env_name] = new_val
                        changed.append(f"pulled {env_name} ← auth.json:{entry_name}")
        except Exception as e:
            print(f"upb sync: warning: auth.json read failed: {e}", file=sys.stderr)

    # ── Pull: opencode.json litellm key ──
    oc_path = Path("~/.config/opencode/opencode.json").expanduser()
    if oc_path.exists():
        try:
            oc = json.loads(oc_path.read_text())
            lk = (oc.get("provider", {}).get("litellm", {}).get("options", {}).get("apiKey", ""))
            if lk and secrets.get("LITELLM_API_KEY") != lk:
                secrets["LITELLM_API_KEY"] = lk
                changed.append("pulled LITELLM_API_KEY ← opencode.json")
        except Exception:
            pass

    # ── Pull: env vars that should be persisted ──
    for var in ("ZAI_API_KEY", "PRIME_INTELLECT_API_KEY", "OLLAMA_API_KEY", "DEEPSEEK_API_KEY"):
        env_val = os.environ.get(var, "")
        if env_val and secrets.get(var) != env_val:
            secrets[var] = env_val
            changed.append(f"pulled {var} ← environment")

    # ── Write secrets.env ──
    if changed or not SECRETS_PATH.exists():
        lines = [
            "# upb secrets — single source of truth for all provider keys",
            "# Managed by: upb sync (pulls from auth.json/opencode.json/env)",
            "# chmod 600 — never commit, never reference from routes.yaml directly",
            "",
        ]
        for k in sorted(secrets):
            lines.append(f"{k}='{secrets[k]}'")
        lines.append("")
        SECRETS_PATH.parent.mkdir(parents=True, exist_ok=True)
        SECRETS_PATH.write_text("\n".join(lines))
        SECRETS_PATH.chmod(0o600)
        print(f"upb sync: wrote {short_path(SECRETS_PATH)} ({len(secrets)} keys)")
    else:
        print(f"upb sync: {short_path(SECRETS_PATH)} already up to date ({len(secrets)} keys)")

    for c in changed:
        print(f"  • {c}")

    # ── Push: secrets.env → router-alibaba.env ──
    router_env = Path("~/shared-local/reports/claude-universal/router-alibaba.env").expanduser()
    ali_key = secrets.get("ALIBABA_TOKEN_PLAN_KEY", "")
    if ali_key and router_env.exists():
        content = router_env.read_text()
        new_content = _re.sub(
            r"^UPB_API_KEY=.*$",
            f"UPB_API_KEY='{ali_key}'",
            content, flags=_re.MULTILINE)
        if new_content != content:
            router_env.write_text(new_content)
            router_env.chmod(0o600)
            print(f"  • pushed ALIBABA_TOKEN_PLAN_KEY → {short_path(router_env)}")
            # Restart systemd service to pick up new key
            try:
                subprocess.run(["systemctl", "--user", "restart", "universal-router.service"],
                               capture_output=True, timeout=10)
                print("  • restarted universal-router.service")
            except Exception as e:
                print(f"  • warning: service restart failed: {e}", file=sys.stderr)
        else:
            print(f"  • {short_path(router_env)} already in sync")

    # ── Model discovery: report new upstream models for discover:true providers ──
    if not getattr(args, "no_discover", False):
        discover_new_models(cfg)

    return 0


# ── main ──────────────────────────────────────────────────────────────

def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0

    parser = argparse.ArgumentParser(prog="upb", add_help=False)
    sub = parser.add_subparsers(dest="cmd")
    p_list = sub.add_parser("list")
    p_list.add_argument("--all", action="store_true")
    p_list.add_argument("--json", action="store_true")
    p_models = sub.add_parser("models")
    p_models.add_argument("provider")
    p_models.add_argument("--refresh", action="store_true")
    p_models.add_argument("--json", action="store_true")
    p_status = sub.add_parser("status")
    p_status.add_argument("--json", action="store_true")
    p_run = sub.add_parser("run")
    p_run.add_argument("route")
    p_run.add_argument("claude_args", nargs=argparse.REMAINDER)
    p_stop = sub.add_parser("stop")
    p_stop.add_argument("route", nargs="?")
    p_stop.add_argument("--all", action="store_true")
    sub.add_parser("default")
    sub.add_parser("doctor")
    p_sync = sub.add_parser("sync")
    p_sync.add_argument("--no-discover", action="store_true",
                        help="skip the new-model discovery check")
    sub.add_parser("env")

    args = parser.parse_args(argv)
    cfg = load_cfg()
    cmd = args.cmd or "list"
    handlers = {"list": cmd_list, "models": cmd_models, "status": cmd_status,
                "run": cmd_run, "stop": cmd_stop, "default": cmd_default,
                "doctor": cmd_doctor, "sync": cmd_sync, "env": cmd_env}
    # `upb` with no subcommand behaves like `upb list`
    if args.cmd is None:
        args.all = False
        args.json = False
    if cmd == "run" and args.claude_args and args.claude_args[0] == "--":
        args.claude_args = args.claude_args[1:]
    return handlers[cmd](cfg, args)


if __name__ == "__main__":
    sys.exit(main())
