# Example routes config — copy to ~/.config/upb/routes.yaml and customize.
#
# THE INVARIANT: a provider's valid model list IS its live /models endpoint.
# Nothing here enumerates served models. Models are discovered by `upb models`,
# validated at `upb run` time against <base_url>/models (or <models_base_url>),
# and mirrored on every proxy's own GET /v1/models.
#
# Optional pins (all validated against the live catalog by `upb verify` and at
# run time — a retired id is a hard error, not a silent 404):
#   default_model  marks a live provider eligible as the overall default route;
#                  usage-metered providers should omit it (explicit-run only)
#   opus_model / sonnet_model / haiku_model   wire-tier pins; everything else
#                  derives from the run's model (claude_env entries override)
#   models: {}     is pricing METADATA ONLY — it never gates validity

version: 1
defaults:
  claude_env:
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: '1'
    API_TIMEOUT_MS: '600000'
    CLAUDE_CODE_ALWAYS_ENABLE_EFFORT: '1'
proxy:
  dir: ~/upb/router
  entry: dist/index.js
  node: node
  ready_timeout_s: 15
  pid_dir: /tmp
providers:
  alibaba:
    label: Alibaba Token Plan (Pro)
    kind: upb
    upb_provider: alibaba-token-plan
    base_url: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
    trust_zone: remote-approved
    key:
      type: env
      var: ALIBABA_TOKEN_PLAN_KEY
    local_secret: claude-alibaba-poser
    priority: 10
    enabled: true
    default_model: qwen3.8-max-preview
    # Pricing stays metadata (models: is never a validity list):
    models:
      qwen3.8-max-preview:
        pricing:
          input_per_1m: 0.25
          output_per_1m: 0.75
      deepseek-v4-pro:
        pricing:
          input_per_1m: 2.50
          output_per_1m: 5.00
  zai:
    label: Z.AI Coding Plan (year-long)
    kind: anthropic-native
    base_url: https://api.z.ai/api/anthropic
    # Anthropic-native endpoints don't speak OpenAI /models; point the catalog
    # at the paas listing so it is audited and live-validated like the rest.
    models_base_url: https://api.z.ai/api/paas/v4
    trust_zone: remote-approved
    key:
      type: env
      var: ZAI_API_KEY
    priority: 20
    enabled: true
    default_model: glm-5.2
    haiku_model: glm-5-turbo   # cheap tier for subagents/haiku
    # No claude_env model pins needed — wire names derive from the route model
    # and the role keys above. (Hand-pinning ANTHROPIC_MODEL* is still allowed
    # but `upb verify` checks each pin against the live catalog.)
  zen:
    label: OpenCode Zen (free tier)
    kind: upb
    upb_provider: zen-free
    base_url: https://opencode.ai/zen/v1
    trust_zone: remote-approved
    key: none
    local_secret: claude-zen-poser
    priority: 30
    enabled: true
    cooldown_seconds: 39600   # free-tier exhaustion cooldown (~11h per panopticon HANDOFF)
    # discover_match: narrow `upb models` to ids containing this substring
    # (free tier only — the full catalog is always fetched and run-validated).
    discover_match: free
    default_model: deepseek-v4-flash-free
  opencode-go:
    label: OpenCode Go subscription ($10/mo)
    kind: upb
    base_url: https://opencode.ai/zen/go/v1
    trust_zone: remote-approved
    key:
      type: env
      var: OPENCODE_GO_KEY
    local_secret: claude-ogo-poser
    priority: 35
    enabled: true
    headers:
      x-opencode-session: upb-proxy-stable
    # No default_model: subscription spend limits make it explicit-run only.
    models: {}
  prime-intellect:
    label: PrimeIntellect Inference (pay-per-use)
    kind: upb
    base_url: https://api.pinference.ai/api/v1
    trust_zone: remote-approved
    key:
      type: env
      var: PRIME_INTELLECT_API_KEY
    local_secret: upb-pi-poser
    priority: 50
    enabled: true
    # usage-metered, balance unknown — explicit runs only, never the default
    models: {}
  # ── DEPRECATED OPT-OUT ── endpoints that serve no /models listing. Avoid:
  # you hand-maintain truth that drifts silently. The escape hatch exists for
  # exotic self-hosted servers; `upb models`/`verify`/`run` fall back to the
  # `models:` list for these, and wire pins are your responsibility.
  # legacy-local:
  #   kind: upb
  #   catalog: static
  #   base_url: http://some-box:9999/v1
  #   key: none
  #   models:
  #     only-model:
  #       pricing: {input_per_1m: 0.0, output_per_1m: 0.0}
